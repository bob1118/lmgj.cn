---
import { Image } from 'astro:assets';
import { strength, type Pair, type ProductImage } from '../data/content';
import { assetImage, toLightboxImages } from '../lib/images';

type MediaItem = ProductImage & { label: Pair };

const icons: string[] = [
  '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="14" height="18" rx="2"/><path d="M8 8h6M8 12h6M8 16h4"/></svg>',
  '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v3M12 18.2v3M2.8 12h3M18.2 12h3M5.5 5.5l2.1 2.1M16.4 16.4l2.1 2.1M18.5 5.5l-2.1 2.1M7.6 16.4l-2.1 2.1"/></svg>',
  '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h9M4 12h9M4 18h9"/><path d="M15.5 6l1.6 1.6L20.5 4M15.5 12l1.6 1.6L20.5 10M15.5 18l1.6 1.6L20.5 16"/></svg>',
  '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 2.6 4 5.6 4 9s-1.2 6.4-4 9c-2.8-2.6-4-5.6-4-9s1.2-6.4 4-9z"/></svg>',
];

// 已有真实素材的卡片：资质与认证（contain，文档需完整展示）；设备、品控、市场（cover，照片填充）
const mediaCards: { index: number; items: MediaItem[]; fit: 'contain' | 'cover' }[] = [
  { index: 0, items: strength.certificates, fit: 'contain' },
  { index: 1, items: strength.equipment, fit: 'cover' },
  { index: 2, items: strength.qualityControl, fit: 'cover' },
  { index: 3, items: strength.market, fit: 'cover' },
];
---

<section class="strength" id="strength">
  <div class="container">
    <div class="section-head">
      <span class="kicker">
        <span class="i18n-zh" lang="zh-CN">实力与体系</span>
        <span class="i18n-en" lang="en">Strength & System</span>
      </span>
      <h2>
        <span class="i18n-zh" lang="zh-CN">{strength.title.zh}</span>
        <span class="i18n-en" lang="en">{strength.title.en}</span>
      </h2>
      <div class="products-head-extra">
        <p>
          <span class="i18n-zh" lang="zh-CN">{strength.intro.zh}</span>
          <span class="i18n-en" lang="en">{strength.intro.en}</span>
        </p>
      </div>
    </div>

    <div class="strength-grid">
      {
        mediaCards.map((media) => {
          const card = strength.cards[media.index];
          const lb = toLightboxImages(media.items);
          return (
            <div class="strength-card media-card">
              <div class="card-side">
                <div class="icon" aria-hidden="true" set:html={icons[media.index]} />
                <h3>
                  <span class="i18n-zh" lang="zh-CN">{card.title.zh}</span>
                  <span class="i18n-en" lang="en">{card.title.en}</span>
                </h3>
              </div>
              <div class="media-grid">
                {media.items.map((item, i) => (
                  <a
                    class="media-item"
                    href={lb[i]?.src ?? item.src}
                    title={`${item.alt.zh} / ${item.alt.en}`}
                    data-lb-images={JSON.stringify(lb)}
                    data-lb-index={String(i)}
                  >
                    <Image
                      src={assetImage(item.src)}
                      alt={item.alt.zh}
                      data-alt-zh={item.alt.zh}
                      data-alt-en={item.alt.en}
                      width={600}
                      widths={[480, 600, 900]}
                      sizes="(max-width: 860px) 50vw, 330px"
                      loading="lazy"
                      decoding="async"
                      class={media.fit === 'cover' ? 'fit-cover' : undefined}
                    />
                    <span class="media-name">
                      <span class="i18n-zh" lang="zh-CN">{item.label.zh}</span>
                      <span class="i18n-en" lang="en">{item.label.en}</span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .products-head-extra {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
</style>
