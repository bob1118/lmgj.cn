---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Products from '../components/Products.astro';
import Strength from '../components/Strength.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

// draft：标题/描述由「针织与织造」扩为「面料 + 配饰」，待企业确认
const title = '金华莱盟纺织品有限公司 — 面料与服饰配饰进出口 | Jinhua Laimeng Textile Factory';
const titleEn = 'Jinhua Laimeng Textile Factory — Fabrics & Accessories Import & Export';
const description =
  '金华莱盟纺织品有限公司（Jinhua Laimeng Textile Factory）专注面料与服饰配饰进出口贸易，涵盖针织、梭织、流行新品面料及珠饰配饰，为国内外采购商提供选料、打样到大货交付的一站式服务。Fabrics & accessories import and export — sourcing, sampling and bulk delivery for buyers worldwide.';
const descriptionEn =
  'Jinhua Laimeng Textile Factory specializes in fabrics and accessories import & export — one-stop service from sourcing, sampling to bulk delivery for buyers worldwide. 金华莱盟纺织品有限公司专注面料与服饰配饰进出口贸易。';
---
<Layout title={title} description={description} titleEn={titleEn} descriptionEn={descriptionEn}>
  <Header />
  <main id="main">
    <Hero />
    <About />
    <div class="weave-divider" aria-hidden="true"></div>
    <Products />
    <Strength />
    <div class="weave-divider" aria-hidden="true"></div>
    <Contact />
  </main>
  <Footer />
</Layout>
